# Vercel Hobby 部署环境变量示例
# 复制到 Vercel Project → Settings → Environment Variables（Production 环境）。
# 详细说明见 docs/RUNBOOK.md「Vercel + Cloudflare Pages 直连 Deployment」章节。

# ---- 部署模式（必填）----
# workers = 纯在线路由（edge-tts/mimo），不注册本地模型路由
DEPLOY_TARGET=workers
APP_ENV=production
DEBUG=false
LOG_TO_FILE=false

# ---- 鉴权（必填）----
# 共享 Bearer 口令：无域名直连方案的唯一凭证，前端解锁页输入后逐请求带
# Authorization: Bearer <token>。用 openssl rand -hex 32 生成。
ACCESS_TOKEN=__REPLACE_ME__
ACCESS_ENFORCEMENT=true
# 可选：仅 CF Worker 网关方案（gateway/，需自有域名 + Access）使用，
# 与网关的 GATEWAY_SECRET secret 保持一致；无域名直连方案留空即可
# GATEWAY_SECRET=

# ---- CORS（必填）----
# Pages 前端域名，逗号分隔多个
CORS_ORIGINS=https://your-app.pages.dev

# ---- Supabase（必填）----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=__REPLACE_ME__
SUPABASE_STORAGE_BUCKET=voice-assets
ASSET_STORE_BACKEND=auto
# Supabase Auth 用户 JWT 的 aud 校验值（默认 authenticated，Supabase 标准值，一般不用改）
# SUPABASE_JWT_AUD=authenticated
# 管理员邮箱（逗号分隔，大小写不敏感）：可访问 /api/admin/* 统计后台；
# 旧凭证通道（ACCESS_TOKEN 等）恒为管理员，无需列入
# ADMIN_EMAILS=you@example.com

# ---- 小米 MiMo 在线 TTS/克隆（必填）----
MIMO_API_KEY=__REPLACE_ME__
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ---- 可选 ----
# 出站 API 超时秒数；workers 模式自动 Cap 到 250s（Vercel 300s 上限留余量），一般不用改
# UPSTREAM_TIMEOUT_SECONDS=120
