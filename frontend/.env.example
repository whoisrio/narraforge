# Cloudflare Pages 部署时填写；本地开发无需设置（默认走 Vite proxy 的 /api）
# 后端 API 基础地址（含 /api 前缀），无域名直连方案填 Vercel 地址，例：https://your-project.vercel.app/api
VITE_API_BASE_URL=

# 共享口令认证开关（无域名直连方案）：Pages 环境变量设 true 后启用解锁页 + Bearer 注入；
# 本地开发留空（或 false），前端行为完全不变
VITE_AUTH_REQUIRED=

# LangGraph agent 服务地址（仅本地模式的工作流用），例：http://127.0.0.1:2024
VITE_AGENT_URL=
