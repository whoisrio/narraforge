# Cloudflare Pages 部署时填写；本地开发无需设置（默认走 Vite proxy 的 /api）
# 后端 API 基础地址（含 /api 前缀），无域名直连方案填 Vercel 地址，例：https://your-project.vercel.app/api
VITE_API_BASE_URL=

# Supabase Auth 开关：Pages 环境变量设 true 后启用登录页 + Supabase JWT Bearer 注入；
# 本地开发留空（或 false），前端行为完全不变
VITE_AUTH_REQUIRED=

# Supabase 项目配置（仅 VITE_AUTH_REQUIRED=true 时必填；anon key 为公开密钥）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LangGraph agent 服务地址（仅本地模式的工作流用），例：http://127.0.0.1:2024
VITE_AGENT_URL=

# 联系管理员邮箱：配置后创作工作区侧栏底部展示「联系管理员」mailto 入口；留空则不展示
VITE_ADMIN_EMAIL=
